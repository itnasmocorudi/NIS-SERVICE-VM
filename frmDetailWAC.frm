Attribute VB_Exposed = False
Public isBooking As Boolean
Public noOrder As String
Public NoBooking As String

Public noChassis As String
Public sSQL As String
Public rsTemp As New ADODB.Recordset
Dim fotoStream As ADODB.Stream
Public idAntrian As String
Public tipe As String
Public nomor As String
Public Tanggal As String




Private Sub createHeader()
    With gridDetail
        .Columns(0).Width = 1700
        .Columns(0).Caption = "Kondisi"
        .Columns(0).DataField = "kondisi"
        .Columns(0).Locked = True
        .Columns(1).Width = 2500
        .Columns(1).Caption = "Bagian"
        .Columns(1).DataField = "bagian"
        .Columns(1).Locked = True
        .Columns(2).Width = 3000
        .Columns(2).Caption = "Posisi"
        .Columns(2).DataField = "posisi"
        .Columns(2).Locked = True
        .Columns(3).Width = 1500
        .Columns(3).Caption = "PIC"
        .Columns(3).DataField = "pic"
        .Columns(3).Visible = False
        .Columns(4).Width = 1500
        .Columns(4).Caption = "adaFoto"
        .Columns(4).DataField = "adaFoto"
        .Columns(4).Visible = False
        .Columns(5).Width = 1500
        .Columns(5).Caption = "idwac"
        .Columns(5).DataField = "idwac"
        .Columns(5).Visible = False
    End With
End Sub

Private Sub btnHapus_Click()
   On Error GoTo btnHapus_Click_Error

    If MsgBox("Apakah yakin untuk menghapus data ini?", vbYesNo) = vbYes Then
        Call objO.InsertData("DELETE FROM detailWAC WHERE idwac = " & rsTemp.Fields("idWac").value)
        Call refreshData
    End If

   On Error GoTo 0
   Exit Sub

btnHapus_Click_Error:

    MsgBox "Error " & err.Number & " (" & err.Description & ") in procedure btnHapus_Click of Form frmDetailWAC"
End Sub

Private Sub refreshData()
    If rsTemp.State Then rsTemp.Close
    Set rsTemp = objO.FetchData("SELECT idWac,matrix,kondisi,bagian,posisi,pic,adaFoto FROM detailWAC WITH (NOLOCK) WHERE ISNULL(clear,'0') = '0' AND idAntrian = (select top 1 ID from " & Log.LogQueue & "..Queue where Nomor = '" & Trim(nomor) & "' and Tipe = '" & Trim(tipe) & "' and CONVERT(varchar(10), Tgl_Panggil, 101) = '" & Format(Tanggal, "MM/DD/YYYY") & "') ")
    If Not rsTemp.EOF Then
        Set gridDetail.DataSource = rsTemp
        Call createHeader
        btnHapus.Enabled = True
    Else
        btnHapus.Enabled = False
    End If
    lblJumlah.Caption = rsTemp.RecordCount
End Sub
Private Sub Form_Load()
    refreshData
End Sub

Private Sub gridDetail_RowColChange(LastRow As Variant, ByVal LastCol As Integer)

   On Error GoTo gridDetail_RowColChange_Error

    If CInt(rsTemp!adaFoto) = 1 Then
        Set fotoStream = New ADODB.Stream
        With fotoStream
            .Type = adTypeBinary
            .Open
            .Write rsTemp.Fields("pic").value 'rsTemp.Fields("pic").VALUE
        
            .SaveToFile App.Path & "\detailWac.bmp", adSaveCreateOverWrite
            
            Image1.Picture = LoadPicture(App.Path & "\detailWac.bmp")
        End With
    Else
        Image1.Picture = Nothing
    End If

   On Error GoTo 0
   Exit Sub

gridDetail_RowColChange_Error:

End Sub

