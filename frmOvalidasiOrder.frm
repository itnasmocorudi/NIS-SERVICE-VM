            If Get_ConnectionNis(NisDb, NisUSER, NisPass, NisKomp) Then
                If rsHlp2.State Then rsHlp2.Close
                ' INTRN.KODEITEM
                Set rsHlp2 = oConnNis.Execute("SELECT SUBSTRING(INTRN.KODEITEM, (CHARINDEX('-',INTRN.KODEITEM) - 1), (LEN(INTRN.KODEITEM)-(CHARINDEX('-',INTRN.KODEITEM) - 1))) AS KODEITEM, NAMABARANG, KODESATUAN, SUM(QTY) AS JML FROM INTRN INNER JOIN INMST ON INTRN.KODEITEM=INMST.KODEITEM " _
                                         & "WHERE INMST.KODEGDG = '04' AND SBRBUKTI = '" & Trim(nWO) & "' GROUP BY SBRBUKTI, INTRN.KODEITEM, NAMABARANG, KODESATUAN HAVING SUM(QTY) <> 0")
                If Not rsHlp2.EOF Then
                    Do While Not rsHlp2.EOF
                        
