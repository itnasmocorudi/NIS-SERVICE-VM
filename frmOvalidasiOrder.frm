    '                        Else
                                .AddNew
                                !KODEITEM = rsHlp2("KODEITEM")
                                !NAMAITEM = rsHlp2("NAMABARANG")
                                !SATUAN = rsHlp2("KODESATUAN")
                                !QTYORDER = 0
