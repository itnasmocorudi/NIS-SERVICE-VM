Private Sub panggilWO(nWO As String)
    
    If rsHlp.State Then rsHlp.Close
    Set rsHlp = oConn.Execute("SELECT * FROM JOBDTA A INNER JOIN CUSTDAT B ON A.NO_CHASSIS = B.NO_CHASSIS WHERE NO_WO = '" & nWO & "'")
