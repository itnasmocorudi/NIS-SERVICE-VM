        text(3) = rsHlp("CUSTOMER")
        text(4) = rsHlp("CUST_ADRES")
        text(5) = rsHlp("KOTA")
        text(6) = rsHlp("TELPON")
        text(7) = rsHlp("GSM")
        text(8) = rsHlp("CDMA")
        text(9) = CDbl(rsHlp("FS_TH_MOBIL"))
        text(17) = TglDDMMYYYY(rsHlp("DOTAM"))
        text(10) = rsHlp("MDL")
        text(11) = rsHlp("MODEL")
        text(12) = rsHlp("FMDL")
        text(13) = rsHlp("COLOR")
        text(14) = rsHlp("NO_POLISI")
        text(15) = rsHlp("NO_CHASSIS")
        text(16) = rsHlp("NO_ENGINE")
        
        ' PART
        If createPart Then
'            If rsHlp2.State Then rsHlp2.Close
