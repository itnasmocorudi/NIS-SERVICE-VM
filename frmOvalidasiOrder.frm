        .Columns(4).Width = 800
        .Columns(4).Caption = "Supply"
        .Columns(4).DataField = "QTYSUPPLY"
        .Columns(5).Width = 1800
        .Columns(5).Caption = "User Entry"
        .Columns(5).DataField = "USERENTRY"
    End With
End Sub

Private Function createPart() As Boolean
    
    createPart = False
    With rsPart
        If .State Then .Close
        .Fields.Append "KODEITEM", adChar, 50
        .Fields.Append "NAMAITEM", adChar, 100
        .Fields.Append "SATUAN", adChar, 10
        .Fields.Append "QTYORDER", adDouble
        .Fields.Append "QTYSUPPLY", adDouble
        .Fields.Append "USERENTRY", adChar, 50
        .Open
        
        If .State <> adStateClosed Then
            createPart = True
        End If
    End With
End Function

Private Sub hapusForm()
    
    For i = 0 To 17
        Select Case i
            Case 6, 7, 8
                text(i) = ">>>>>>>>>>>>>>"
                text(i).Mask = "9999-9999999999"
            Case 17
                text(i) = ">>->>->>>>"
                text(i).Mask = "99-99-9999"
            Case Else
                text(i) = ""
        End Select
    Next
    
    If rsPart.State Then rsPart.Close
    Set rsPart = Nothing
    
    cmdTutup.Enabled = False
End Sub

Private Sub cmdTutup_Click()
    
    oConn.Execute ("INSERT INTO NOTEPART (NOSO, TIPE) VALUES ('" & Trim(text(0)) & "', 'I')")
    MsgBox "Pesan dikirim ..."
    Call hapusForm
End Sub

Private Sub text_GotFocus(Index As Integer)
    Dim DiTab As Boolean
    DiTab = False
    
    If text(Index).BackColor = &HC0E0FF Then
        DiTab = True
    Else
        If gMainKeyCari <> "" Then
            text(Index).Mask = ""
            text(Index) = gMainKeyCari
            gMainKeyCari = ""
            DiTab = True
        End If
    End If
    
    If DiTab Then
        SendKeys ("{TAB}")
    Else
        SendKeys ("{HOME}+{END}")
    End If
End Sub

Private Sub Text_KeyPress(Index As Integer, KeyAscii As Integer)
    KeyAscii = UpCase(KeyAscii)
    Select Case Index
        Case 0
            KeyAscii = CekNumerik(KeyAscii)
            simpan = False
    End Select
End Sub

Private Sub text_KeyDown(Index As Integer, KeyCode As Integer, Shift As Integer)
    Call CekTombol(KeyCode)
    If KeyCode = vbKeyF12 Then
        Select Case Index
            Case 0
                gMainKeyCari = text(Index)
                gSearchOption = "VALIDPART"
                frmCariAcess.Show (vbModal)
        End Select
    End If
End Sub

Private Sub cmdKeluar_Click()
    Unload Me
End Sub

Private Sub Form_Load()
    Call hapusForm
    cmdTutup.Enabled = False
End Sub

Private Sub text_Validate(Index As Integer, Cancel As Boolean)
Dim n As String
    Select Case Index
        Case 0
            If text(Index) <> "" Then
                If Get_ConnectionNis(NisDb, NisUSER, NisPass, NisKomp) Then
                    sSQL = "SELECT * FROM INTRN WHERE SBRBUKTI = '" & Trim(text(Index)) & "'"
                    oRs1.Open sSQL, oConnNis, adOpenStatic
                    If oRs1.EOF Then
                        gMainKeyCari = text(Index)
                        gSearchOption = "VALIDPART"
                        frmCariAcess.Show (vbModal)
                    Else
                        n = Trim(text(Index))
                        Call hapusForm
                        text(Index) = n
                        Call panggilWO(n)
                    End If
                End If
                If oConnNis.State <> adStateClosed Then oConnNis.Close
            End If
    End Select
End Sub
