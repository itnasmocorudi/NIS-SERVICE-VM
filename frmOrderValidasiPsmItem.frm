Private Sub cmdHapus_Click()
    Dim item As String
    
    If Not rsGridPsm.EOF Then
        If MsgBox("Apakah yakin akan menghapus data ini?", vbYesNo) = vbYes Then
       
            sSQL = "DELETE FROM ReplBengkel99..[P2_MonitorSvcProgress_psm] WHERE [wo_number] = '" & Right(gDb, 2) & "." & NulSID(Text(4)) & "' and [part_number] = '" & NulSID(rsGridPsm!part_number) & "' and [psm_item_category] = '" & NulSID(rsGridPsm!psm_item_category) & "'"
            Call objO.InsertData(sSQL)
            MsgBox "Data berhasil disimpan", vbInformation
            Call refreshGridPsm
        End If
    End If
End Sub

