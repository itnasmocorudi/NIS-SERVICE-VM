Private Sub cmdSimpan_Click()
          Dim isBoleh As Boolean
          Dim keterangan As String
          Dim item, pilihPart As String
1         keterangan = ""
2         isBoleh = True
          
          
3         If NulSID(cboCategory) = "-" Then
4             isBoleh = False
5             keterangan = keterangan & "- Item Category harus dipilih" & vbCrLf
6         Else
7             If NulSID(cboCategory) = NulSID("Auxiliary battery (charging status)") Then
8                 item = "01"
9             ElseIf NulSID(cboCategory) = NulSID("Auxiliary battery (degraded state)") Then
10                item = "02"
11            ElseIf NulSID(cboCategory) = NulSID("Engine oil degradation (Phase2)") Then
12                item = "03"
13            ElseIf NulSID(cboCategory) = NulSID("Key battery power status") Then
14                item = "04"
15            Else
16                item = "Unknown"
17            End If
18        End If
          
19        If item = "02" Then
20            If NulSID(cboPart) = "-" Then
21                isBoleh = False
22                keterangan = keterangan & "- Kode Part harus dipilih" & vbCrLf
23            Else
24                pilihPart = NulSID(cboPart)
25            End If
26        End If
          
27        If isBoleh Then
28            sSQL = "INSERT INTO ReplBengkel99..[P2_MonitorSvcProgress_psm] ([wo_number],[part_number],[psm_item_category],[maintenance_tsp],[maintenance_type],[validasi]) "
29            sSQL = sSQL & " VALUES ('" & Right(gDb, 2) & "." & NulSID(Text(4)) & "','" & NulSID(pilihPart) & "','" & item & "','" & Format(Now, "yyyy-mm-dd") & "','" & IIf(pilihPart = "", "", "01") & "',0)"
30            Call objO.InsertData(sSQL)
