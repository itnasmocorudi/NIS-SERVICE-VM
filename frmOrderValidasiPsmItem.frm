35        End If
End Sub

Private Sub Form_Activate()
    If isLoad = False Then
        cboCategory.Clear
        cboCategory.AddItem NulSID("-")
        sSQL = "select b.psm_item_category,CASE b.psm_item_category WHEN '01' THEN 'Auxiliary battery (charging status)' WHEN '02' THEN 'Auxiliary battery (degraded state)'"
        sSQL = sSQL & " WHEN '03' THEN 'Engine oil degradation (Phase2)' WHEN '04' THEN 'Key battery power status' ELSE 'Unknown' END AS [deskripsi]"
        sSQL = sSQL & " from ReplBengkel99..p2_psm a with (nolock) inner join ReplBengkel99..p2_psm_item b on a.vin=b.vin"
        sSQL = sSQL & " where a.vin='" & NulSID(Text(1)) & "'"
        Set rsTemp = objO.FetchData(sSQL)
        If Not rsTemp.EOF Then
            rsTemp.MoveFirst
            Do While Not rsTemp.EOF
                cboCategory.AddItem NulSID(rsTemp!deskripsi)
                rsTemp.MoveNext
            Loop
        End If
        cboCategory.ListIndex = 0
        cboPart.Clear
        cboPart.AddItem NulSID("-")
        Set rsTemp = objO.FetchDataACC("select KodeItem as KODE_ITEM, Keterangan as NAMA_ITEM, Qty, NamaBYSA from SOORD WITH (NOLOCK) Where NoSO = '" & NulSID(Text(4)) & "' and AddJob = 0 and (isnull(BO,'null')='null' or isnull(bo,'') <> 'CANCEL')")
    
        If Not rsTemp.EOF Then
            rsTemp.MoveFirst
            Do While Not rsTemp.EOF
                cboPart.AddItem NulSID(rsTemp!KODE_ITEM)
                rsTemp.MoveNext
            Loop
        End If
        cboPart.ListIndex = 0
        Call refreshGridPart
        Call refreshGridPsm
        isLoad = True
    End If
End Sub

Private Sub refreshGridPart()
    Set rsGridPart = objO.FetchDataACC("select KodeItem as KODE_ITEM, Keterangan as NAMA_ITEM, Qty, NamaBYSA from SOORD WITH (NOLOCK) Where NoSO = '" & NulSID(Text(4)) & "' and AddJob = 0 and (isnull(BO,'null')='null' or isnull(bo,'') <> 'CANCEL')")
    GridPart.DataSource = rsGridPart
    GridPart.Refresh
End Sub

Private Sub refreshGridPsm()
    sSQL = "SELECT [part_number],[psm_item_category] FROM ReplBengkel99..[P2_MonitorSvcProgress_psm] WHERE [wo_number] = '" & Right(gDb, 2) & "." & NulSID(Text(4)) & "'"
    Set rsGridPsm = objO.FetchData(sSQL)
    GridPSM.DataSource = rsGridPsm
    GridPSM.Refresh
    
End Sub

Private Sub Text_KeyDown(Index As Integer, KeyCode As Integer, Shift As Integer)
On Error GoTo Text_KeyDown_Error

    Call CekTombol(KeyCode)
    If KeyCode = vbKeyF12 Then
        Select Case Index
            Case 5
                gMainKeyCari = Text(Index)
                gSearchOption = "PART"
                'gBantuan3 = Format(text(65), "dd/mm/yyyy")
                
                frmCariAcess.show (vbModal)
                
        End Select
    End If
   'On Error GoTo 0
   Exit Sub

Text_KeyDown_Error:
'' 20181002REV2 ' MENCATAT ERROR LINE NUMBER SEBELUM DITAMPILKAN
varErlError = Erl
varErrNumber = err.Number
'' varErlError,varErrNumber
    MsgBox "Terjadi Kesalahan " & vbCrLf & ErrMessage(varErlError, varErrNumber, " (" & err.Description & ") in procedure Text_KeyDown of Form frmOrder")

End Sub
