Attribute VB_Name = "frmRepoLockAR"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit
Private rsAr As ADODB.Recordset

Private Sub cmdExport_Click()
1         On Error GoTo Err_Export
          Dim Er As New ErrInfo
2         If rsAr.RecordCount = 0 Then
3             Er.HeadCap = "Export To Excel !"
4             Er.InfoCap = "Tidak ada data untuk di export !"
5             Beep
6             Er.show (vbModal)
7             Exit Sub
8         End If
          Dim MyPath As String
          Dim onVal As String
9         MyPath = ""
          Dim f As New FormExplorer
10        f.show (vbModal)
11        MyPath = f.PathSaving
12        If MyPath = "" Then Exit Sub
13        If Right(MyPath, 1) <> "\" Then MyPath = MyPath & "\"
14        If f.FileName = "" Then Exit Sub
15        onVal = MyPath & f.FileName & ".XLS"
          
16         Grid.ExportToFile onVal, True
17                Er.HeadCap = "Export to excel !"
18                Er.InfoCap = "Data sudah di Export ke File Excel." & Chr(13) & _
                               "File : " & onVal
                  
19                Beep
20                Er.show (vbModal)
21         Exit Sub
Err_Export:
22        MsgBox err.Number & Chr(13) & "ERROR - Procedure : " & Me.Name & " export xls", vbInformation + vbOKOnly, "Lock AR"
Keluar:
End Sub

Private Sub cmdExit_Click()
    Unload Me
End Sub

Private Sub cmdView_Click()
    If Dt(1).Text = "__/__/____" Then Exit Sub
    If Dt(1) < Dt(0) Then Exit Sub
    Set rsAr = objO.FetchValidasiAR_Report(Dt(0), Dt(1))
    If rsAr.RecordCount > 0 Then
        Grid.DataSource = rsAr
    Else
        Grid.DataSource = Nothing
        MsgBox "Tidak ada data pada range tanggal tersebut !", vbInformation + vbOKOnly, "Lock AR"
    End If
End Sub

