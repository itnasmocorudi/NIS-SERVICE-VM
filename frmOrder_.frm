Private Sub cmdSimpanAdjustDSS_Click()
1         On Error GoTo vbError
          Dim strSql As String
          
          ''2016-05-17 || Validasi adjust minimal 00:10
2         If cariJumlahMenit(Trim(Text(122))) < 10 Then
3           MsgBox "Adjust Minimal 10 menit / 00:10 ", vbInformation
4           Exit Sub
5         End If
          
          ''2016-05-17 || format > 59 menit dan format > 23 jam
6           If CInt(Left(Trim(Text(122)), InStr(1, Trim(Text(122)), ":") - 1)) > 23 Then
7              MsgBox "Format adjust salah, jam tidak boleh melebihi 23 jam ", vbInformation
8              Exit Sub
9           ElseIf CInt(Right(Trim(Text(122)), InStr(1, Trim(Text(122)), ":") - 1)) > 59 Then
10             MsgBox "Format adjust salah, format dalam jam : menit", vbInformation
11             Exit Sub
12          End If
          
13        cmdSimpanAdjustDSS.Enabled = False
14        cmdBatalAdjustDMS.Enabled = False
          
          ''2016-05-03 | rate diambil dari adjust
15        txtNRate.Text = Round(cariJumlahMenit(Trim(Text(122))) / 60, 2)
          
16        If Log.isDSS = False Then
17            Call prosesPilihStallManual(False)
18            Exit Sub
19        Else
20            If Trim(Text(64)) <> "" Then
                  'jika sudah terbuat wo
21                strSql = "SELECT NO_WO, B.TIPEBP, C.SKILLMIN, E.LEVEL AS LvlTech, C.STALLMIN, D.level AS LvlStall, C.LiftNeed " & _
                       "FROM HO_Flate B INNER JOIN JOBDTA A ON  A.MDL = B.MDL " & _
                       "LEFT JOIN MASTERDSS C ON B.TIPEBP = C.KODEDSS " & _
                       "LEFT JOIN LevelStall D ON C.StallMin = D.KodeStall " & _
                       "LEFT JOIN T_MECHLEV E ON C.SkillMin = E.LEVELMECH " & _
                       "WHERE NO_WO = '" & Trim(Text(64)) & "' AND (" & jobQuery & ") AND ISNULL(C.SkillMin,'') <> '' AND dss = 1" & _
                       "order by LvlStall desc ,LvlTech desc "
22            Else
                  'jika belum terbuat wo
23                strSql = "SELECT B.TIPEBP, C.SKILLMIN, E.LEVEL AS LvlTech, C.STALLMIN, D.level AS LvlStall, C.LiftNeed " & _
                      "FROM  HO_Flate B " & _
                      "LEFT JOIN MASTERDSS C ON B.TIPEBP = C.KODEDSS " & _
                      "LEFT JOIN LevelStall D ON C.StallMin = D.KodeStall " & _
                      "LEFT JOIN T_MECHLEV E ON C.SkillMin = E.LEVELMECH " & _
                      "WHERE B.MDL = '" & Trim(Text(10)) & "' AND (" & jobQuery & ") AND ISNULL(C.SkillMin,'') <> '' AND dss = 1 " & _
                      "order by LvlStall desc ,LvlTech desc "
24            End If
              
25            Set rsTemp = objO.FetchData(strSql)
              
26            If Not rsTemp.EOF Then
                  'jika nowo tsb masuk dss
27                rsTemp.MoveFirst
28                If Log.newJpcb = 1 Then
29                    strSql = "SELECT convert(integer,REPLACE(noStall,'Stall ','')) nos,*,"
30                    strSql = strSql & " case when tek1 <> '' then (select top 1 tanggal + pause from tempProgress where MECH = st.tek1 order by TANGGAL + PAUSE desc) else '01/01/3000' end as idle1,"
31                    strSql = strSql & " case when tek2 <> '' then (select top 1 tanggal + pause from tempProgress where MECH = st.tek2 order by TANGGAL + PAUSE desc) else '01/01/3000' end as idle2,"
32                    strSql = strSql & " case when tek3 <> '' then (select top 1 tanggal + pause from tempProgress where MECH = st.tek3 order by TANGGAL + PAUSE desc) else '01/01/3000' end as idle3"
33                    strSql = strSql & " FROM ("
34                    strSql = strSql & " SELECT *,"
35                    strSql = strSql & " CASE WHEN S.tek1 <> '' THEN (SELECT LEVEL FROM T_MECHLEV WHERE LEVELMECH = S.LEVEL1) else 0 end AS lvlTech1,"
36                    strSql = strSql & " case WHEN S.tek2 <> '' THEN (SELECT LEVEL FROM T_MECHLEV WHERE LEVELMECH = S.LEVEL2) else 0 end AS lvltech2,"
37                    strSql = strSql & " case WHEN S.tek3 <> '' THEN (SELECT LEVEL FROM T_MECHLEV WHERE LEVELMECH = S.LEVEL3) ELSE 0 END AS LvlTech3"
38                    strSql = strSql & " FROM ("
39                    strSql = strSql & " SELECT DISTINCT B.NOStall,b.activation,"
40                    strSql = strSql & " b.LevelStall as LvlStall,"
41                    strSql = strSql & " case when b.KodeStall = 'EM' then 1 else 0 end as EM,"
42                    strSql = strSql & " case when b.KodeStall = 'SB' then 1 else 0 end as SB,"
43                    strSql = strSql & " case when b.KodeStall = 'GR' then 1 else 0 end as GR,"
44                    strSql = strSql & " case when b.KodeStall = 'SC' then 1 else 0 end as SC,"
45                    strSql = strSql & " case when b.KodeStall = 'NP' then 1 else 0 end as NP,"
46                    strSql = strSql & " case when b.lift = '1' then 1 else 0 end as Lifted,"
47                    strSql = strSql & " tek1, ISNULL(C.levMech,'') AS LEVEL1,"
48                    strSql = strSql & " tek2, ISNULL(D.levMech,'') AS LEVEL2,"
49                    strSql = strSql & " TEK3, ISNULL(E.levMech,'') AS LEVEL3"
50                    strSql = strSql & " FROM SettingStall B"
51                    strSql = strSql & " LEFT JOIN MEKANIK C ON B.tek1 = C.MECH"
52                    strSql = strSql & " LEFT JOIN MEKANIK D ON B.tek2 = D.MECH"
53                    strSql = strSql & " LEFT JOIN MEKANIK E ON B.tek3 = E.MECH  ) S ) ST"
54                    strSql = strSql & " WHERE st.activation = 1 and ST.Lifted = '" & rsTemp("LiftNeed") & "' AND (ST.LvlTech1 >= '" & rsTemp("LvlTech") & "' or st.lvltech2 >= '" & rsTemp("LvlTech") & "' or st.LvlTech3 >= '" & rsTemp("LvlTech") & "') "
55                    strSql = strSql & " ORDER BY st.lvlTech1,st.lvltech2,st.LvlTech3,st.LvlStall,st.noStall  "
56                Else
57                    strSql = "SELECT convert(integer,REPLACE(noStall,'Stall ','')) nos,*,"
58                    strSql = strSql & " case when tek1 <> '' then (select top 1 tanggal + pause from tempProgress where MECH = st.tek1 order by TANGGAL + PAUSE desc) else '01/01/3000' end as idle1,"
59                    strSql = strSql & " case when tek2 <> '' then (select top 1 tanggal + pause from tempProgress where MECH = st.tek2 order by TANGGAL + PAUSE desc) else '01/01/3000' end as idle2, "
60                    strSql = strSql & " case when tek3 <> '' then (select top 1 tanggal + pause from tempProgress where MECH = st.tek3 order by TANGGAL + PAUSE desc) else '01/01/3000' end as idle3 " & _
                               "FROM ( " & _
                               "SELECT *, " & _
                               "CASE WHEN S.EM = 1 THEN (SELECT LEVEL FROM LevelStall WHERE KodeStall = 'EM') " & _
                               "WHEN S.SB = 1 THEN (SELECT LEVEL FROM LevelStall WHERE KodeStall = 'SB') " & _
                               "WHEN S.NP = 1 THEN (SELECT LEVEL FROM LevelStall WHERE KodeStall = 'NP') " & _
                               "WHEN S.SC = 1 THEN (SELECT LEVEL FROM LevelStall WHERE KodeStall = 'SC') " & _
                               "WHEN S.GR = 1 THEN (SELECT LEVEL FROM LevelStall WHERE KodeStall = 'GR') ELSE 0 END AS LvlStall, " & _
                               "CASE WHEN S.tek1 <> '' THEN (SELECT LEVEL FROM T_MECHLEV WHERE LEVELMECH = S.LEVEL1) else 0 end AS lvlTech1, " & _
                               "case WHEN S.tek2 <> '' THEN (SELECT LEVEL FROM T_MECHLEV WHERE LEVELMECH = S.LEVEL2) else 0 end AS lvltech2, " & _
                               "case WHEN S.tek3 <> '' THEN (SELECT LEVEL FROM T_MECHLEV WHERE LEVELMECH = S.LEVEL3) ELSE 0 END AS LvlTech3 " & _
                               "FROM ( " & _
                               "SELECT DISTINCT B.NOStall, " & _
                               "ISNULL((SELECT 1 FROM Lift WHERE Stall = B.NOSTALL AND TIPE = 'L'),'')  AS Lifted, " & _
                               "ISNULL((SELECT 1 FROM Lift WHERE Stall = B.NOSTALL AND TIPE = 'N'),'')  AS NP, " & _
                               "ISNULL((SELECT 1 FROM Lift WHERE Stall = B.NOSTALL AND TIPE = 'E' ),'')  AS EM, " & _
                               "ISNULL((SELECT 1 FROM Lift WHERE Stall = B.NOSTALL AND TIPE = 'S' ),'')  AS SB, " & _
                               "ISNULL((SELECT 1 FROM Lift WHERE Stall = B.NOSTALL AND TIPE = 'X' ),'')  AS SC, " & _
                               "CASE WHEN ISNULL(A.Stall,'') = '' THEN 1 ELSE 0 END AS GR, " & _
                               "tek1, ISNULL(C.levMech,'') AS LEVEL1, tek2, ISNULL(D.levMech,'') AS LEVEL2, TEK3, ISNULL(E.levMech,'') AS LEVEL3 " & _
                               "FROM SettingStall B LEFT JOIN Lift A ON B.noStall = A.Stall AND A.Tipe <> 'L' " & _
                               "LEFT JOIN MEKANIK C ON B.tek1 = C.MECH " & _
                               "LEFT JOIN MEKANIK D ON B.tek2 = D.MECH " & _
                               "LEFT JOIN MEKANIK E ON B.tek3 = E.MECH  " & _
                               ") S ) ST "
61                    strSql = strSql & " WHERE ST.Lifted = '" & rsTemp("LiftNeed") & "' AND (ST.LvlTech1 >= '" & rsTemp("LvlTech") & "' or st.lvltech2 >= '" & rsTemp("LvlTech") & "' or st.LvlTech3 >= '" & rsTemp("LvlTech") & "') "
