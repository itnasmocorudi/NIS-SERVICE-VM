Private Function hitungJam(mnt As Integer) As String
      Dim jamNy As String
      Dim mntNy As String

1        On Error GoTo hitungJam_Error

2         jamNy = Format(Round((mnt / 60) - 0.5, 0), "0#")
3         mntNy = Format(mnt Mod 60, "0#")
          
4         hitungJam = jamNy & ":" & mntNy

5        'On Error GoTo 0
6        Exit Function

hitungJam_Error:

7         MsgBox "Terjadi Kesalahan " & vbCrLf & ErrMessage(Erl, err.Number, " (" & err.Description & ") in procedure hitungJam of Form frmOrder")
End Function

