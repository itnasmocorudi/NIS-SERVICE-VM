    End If
    If (hitungTotalMenit(tempWaktuAwalDSS) > hitungTotalMenit(gridDSS.Columns(4).value)) Then
        gridDSS.Columns(4).value = tempWaktuAwalDSS
        Exit Sub
    End If
    If (hitungTotalMenit(tempWaktuAkhirDSS) >= hitungTotalMenit(gridDSS.Columns(5).value)) And (hitungTotalMenit(gridDSS.Columns(4).value) >= hitungTotalMenit(tempWaktuAwalDSS)) Then
        'hitung waktu adjust
        If hitungTotalMenit(Text(122)) > ((hitungTotalMenit(gridDSS.Columns(5).value)) - (hitungTotalMenit(gridDSS.Columns(4).value))) Then
            MsgBox "Jam mulai dan selesai tidak sesuai adjust waktu " & Trim(Text(122)), vbInformation
            gridDSS.Columns(4).value = tempWaktuAwalDSS
            gridDSS.Columns(5).value = tempWaktuAkhirDSS
        End If
    End If
    Exit Sub
vb_error:
    MsgBox "Terjadi kesalahan saat edit waktu", vbInformation
    gridDSS.Columns(4).value = tempWaktuAwalDSS
    gridDSS.Columns(5).value = tempWaktuAkhirDSS
End Sub

