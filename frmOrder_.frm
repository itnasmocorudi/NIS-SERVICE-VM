Private Sub cetakDetailFIR(keluhan As Byte)
   Dim rpt As New rptDetailFIR
   Set rsTemp = objO.FetchData("SELECT J.FRONT,J.FMDL,J.MDL,D.* FROM DETAILFIR d WITH (NOLOCK) LEFT JOIN JOBDTA J WITH (NOLOCK) ON J.NO_WO = D.NoWo WHERE NOWO = '" & Trim(Text(64)) & "' AND IDKELUHAN = '" & keluhan & "'")
   ''kosongkan data
   ''data kendaraan
   rpt.txtTanggal.SetText ""
   rpt.txtNoPolisi.SetText ""
   rpt.txtModel.SetText ""
   rpt.txtKodeModel.SetText ""
   rpt.txtNoRangka.SetText ""
   rpt.Text8.SetText ""
   rpt.txtNoWO.SetText ""
   ''data keluhan
   rpt.txtKeluhanPelanggan.SetText ""
   
   ''data diagnosa
   rpt.Text23.SetText ""
   rpt.Text25.SetText ""
   rpt.Text27.SetText ""
   rpt.Text29.SetText "... Hari yang lalu"
   
   rpt.Text30.SetText ""
   rpt.Text31.SetText ""
   rpt.Text32.SetText ""
   
   rpt.Text36.SetText ""
   rpt.Text37.SetText ""
   rpt.Text38.SetText ""
   
   rpt.Text43.SetText ""
   rpt.Text44.SetText ""
   rpt.Text45.SetText ""
   
   rpt.Text50.SetText ""
   rpt.Text51.SetText ""
   rpt.Text52.SetText ""
   
   rpt.Text57.SetText ""
   rpt.Text58.SetText ""
   rpt.Text59.SetText ""
   rpt.Text60.SetText ""
   rpt.Text61.SetText ""
   rpt.Text62.SetText ""
   rpt.Text63.SetText ""
   rpt.Text64.SetText ""
   rpt.Text65.SetText ""
   rpt.Text66.SetText ""
   rpt.Text67.SetText ""
   
   ''kondisi saat gejala terjadi
   rpt.Text83.SetText ""
   rpt.Text85.SetText ""
   rpt.Text89.SetText ""
   rpt.Text7.SetText ""
   rpt.Text94.SetText ""
   rpt.Text96.SetText ""
   rpt.Text99.SetText ""
   rpt.Text101.SetText ""
   rpt.Text9.SetText ""
   
   If Not rsTemp.EOF Then
      rsTemp.MoveFirst
      ''data kendaraan
      rpt.Text8.SetText "SA : " & Trim(rsTemp!FRONT)
      rpt.txtTanggal.SetText TglDDMMYYYY(Trim(rsTemp!Tanggal))
      rpt.txtNoPolisi.SetText Trim(rsTemp!NO_POLISI)
      rpt.txtModel.SetText Trim(rsTemp!Fmdl)
      rpt.txtKodeModel.SetText Trim(rsTemp!MDL)
      rpt.txtNoRangka.SetText Trim(rsTemp!No_Chassis)
      rpt.txtNoWO.SetText "No Wo : " & Trim(rsTemp!noWO)
      ''data keluhan
      rpt.txtKeluhanPelanggan.SetText Trim(rsTemp!keluhan)
      
      ''data diagnosa
      
      ''gejala pertama kali
      If Trim(rsTemp!gejalapertama) <> "" Then
         Select Case UCase(Trim(rsTemp!gejalapertama))
            Case "HARI INI"
               rpt.Text23.SetText " X"
            Case "MINGGU LALU"
               rpt.Text25.SetText " X"
            Case Else
               rpt.Text27.SetText " X"
               rpt.Text29.SetText Mid(Trim(rsTemp!gejalapertama), 1, Len(rsTemp!gejalapertama) - 15) & " Hari yang lalu"
         End Select
      End If
      
      If Trim(rsTemp!frekuensi) <> "" Then
         Select Case Trim(rsTemp!frekuensi)
             Case "Sekali"
               rpt.Text30.SetText " X"
            Case "Kadang"
               rpt.Text31.SetText " X"
            Case Else
               rpt.Text32.SetText " X"
         End Select
      End If
      
      If Trim(rsTemp!indikator) <> "" Then
         Select Case Trim(rsTemp!indikator)
             Case "ON"
               rpt.Text36.SetText " X"
            Case "Selalu"
               rpt.Text37.SetText " X"
            Case Else
               rpt.Text38.SetText " X"
         End Select
      End If
       
      If Trim(rsTemp!saatmil) <> "" Then
         Select Case Trim(rsTemp!saatmil)
             Case "Idling"
               rpt.Text43.SetText " X"
            Case "Starting"
               rpt.Text44.SetText " X"
            Case Else
               rpt.Text45.SetText " X"
         End Select
      End If
      
      If Trim(rsTemp!kondisiMesin) <> "" Then
         Select Case Trim(rsTemp!kondisiMesin)
            Case "Panas"
               rpt.Text50.SetText " X"
            Case "Dingin"
               rpt.Text51.SetText " X"
            Case Else
               rpt.Text52.SetText " X"
         End Select
      End If
      
      Dim hasil() As String
      If Trim(rsTemp!shiftlevel) <> "" Then
            hasil() = Split(Trim(rsTemp!shiftlevel), ",")
            For i = 0 To UBound(hasil)
               Select Case hasil(i)
                   Case "1"
                     rpt.Text57.SetText " X"
                  Case "2"
                     rpt.Text60.SetText " X"
                  Case "3"
                     rpt.Text62.SetText " X"
                  Case "4"
                     rpt.Text64.SetText " X"
                  Case "5"
                     rpt.Text66.SetText " X"
                  Case "P"
                     rpt.Text58.SetText " X"
                  Case "R"
                     rpt.Text61.SetText " X"
                  Case "N"
                     rpt.Text63.SetText " X"
                  Case "D"
                     rpt.Text65.SetText " X"
                  Case "S"
                     rpt.Text67.SetText " X"
                  Case Else
                     rpt.Text59.SetText " X"
               End Select
            Next
      End If
      
      ''kondisi saat gejala terjadi
       
      If Trim(rsTemp!Speed) <> "" Then
         rpt.Text83.SetText Trim(rsTemp!Speed)
      End If
            
      If Trim(rsTemp!rpm) <> "" Then
         rpt.Text85.SetText Trim(rsTemp!rpm)
      End If
            
      If Trim(rsTemp!beban) <> "" Then
         rpt.Text89.SetText Trim(rsTemp!beban)
      End If
            
      If Trim(rsTemp!penumpang) <> "" Then
         rpt.Text91.SetText Round(Trim(rsTemp!penumpang), 0)
      End If
            
      If Trim(rsTemp!kondisiJalan) <> "" Then
         rpt.Text7.SetText Replace(Trim(rsTemp!kondisiJalan), ",", " / ")
      End If
            
      If Trim(rsTemp!laluLintas) <> "" Then
         Select Case Trim(rsTemp!laluLintas)
            Case "Macet Stop & Go"
               rpt.Text94.SetText Trim(rsTemp!laluLintas)
            Case "Lancar"
               rpt.Text94.SetText Trim(rsTemp!laluLintas)
            Case Else
               rpt.Text94.SetText "Lainnya : " & Trim(rsTemp!laluLintas)
         End Select
      End If
             
      If Trim(rsTemp!cuaca) <> "" Then
         rpt.Text96.SetText Trim(rsTemp!cuaca)
      End If
      
      
      If Trim(rsTemp!blowerspeedac) <> "" Then
         rpt.Text99.SetText Trim(rsTemp!blowerspeedac)
      End If
        
      If Trim(rsTemp!tempsetting) <> "" Then
         rpt.Text101.SetText Round(Trim(rsTemp!tempsetting), 0)
      End If
      
   End If
