24            isCurrentAR = True
25            If objO.FetchIsValid_AR_Kabeng(Trim(Text(1).Text), Text(64).Text) = True Then GoTo TanpaBatasAR
26            FrAR.Visible = True
27            TimerAR.Enabled = True
28        ElseIf nPersenAR < 80 Then
29            isCurrentAR = False
TanpaBatasAR:
30            FrAR.Visible = False
31            TimerAR.Enabled = False
32        End If

