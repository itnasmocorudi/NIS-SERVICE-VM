Public Sub hapusPart(hKdItem As String, hNmBySA As String, iID As Double)
1        On Error GoTo hapusPart_Error

2         With rsGridPart
3             If rsGridPart.State <> adStateClosed Then
4                 If rsGridPart.RecordCount > 0 Then
5                     If rsGridPart.EOF Then .MoveFirst
6                     If Not rsGridPart.BOF Then
7                         .MoveFirst
8                         Do While Not .EOF
9                             If Trim(!KodeItem) = Trim(hKdItem) And Trim(!namabySA) = Trim(hNmBySA) And !nID = Val(iID) Then
10                                If !ganti Then
11                                    If Not !BAWA Then
12                                        If !oli Then
13                                            Text(59) = CDbl(Text(59)) - HargaPart(rsGridPart)
14                                        Else
15                                            Text(57) = CDbl(Text(57)) - HargaPart(rsGridPart)
16                                        End If
17                                        Text(61) = Format(CDbl(Text(56)) + CDbl(Text(57)) + CDbl(Text(58)) + CDbl(Text(59)) + CDbl(Text(60)) + CDbl(Text(77)), "#0,#")
18                                    End If
19                                End If
20                                .Delete
21                            End If
22                            .MoveNext
23                        Loop
24                    End If
25                End If
26            End If
27        End With

28       'On Error GoTo 0
29       Exit Sub

