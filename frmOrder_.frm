Private Sub saveStall(stl As String, Tgl As Date, jmMul As String, jmSel As String, rte As Double, grp As String, mch As String, Ket As String, adjust As String)
          Dim rsTempSaveStall As ADODB.Recordset
          Dim rsTempSaveStall2 As ADODB.Recordset
          
1        On Error GoTo saveStall_Error
2         Set rsTempSaveStall = objO.FetchData("SELECT * FROM Tempstall WITH(NOLOCK) WHERE nostall = '" & stl & "' AND tanggal = '" & Format(Tgl, "MM/DD/YYYY") & "' AND ((jamMulai BETWEEN '" & jmMul & "' AND '" & jmSel & "') OR (jamSelesai BETWEEN '" & jmMul & "' AND '" & jmSel & "'))")
3         If rsTempSaveStall.EOF Then
4             Set rsTempSaveStall2 = objO.FetchData("SELECT * FROM tempstall WITH(NOLOCK) WHERE tanggal = '" & Format(Tgl, "mm/dd/yyyy") & "' AND keterangan LIKE '" & Left(Ket, InStr(Ket, "|") - 2) & " |%' ")
5             If rsTempSaveStall2.EOF Then
6                 Call objHT.InsertData_BengkelOnly("INSERT INTO tempstall (noStall,Tanggal,jamMulai,jamSelesai,rate,[Group],Mech,flag,Keterangan,ADJUST) VALUES ('" & stl & "','" & Format(Tgl, "mm/dd/yyyy") & "','" & jmMul & "','" & jmSel & "','" & Replace(CDbl(rte), ",", ".") & "','','" & mch & "','','" & Ket & "','" & Trim(adjust) & "')")     '" & grp & "
7             Else
8                 Call objHT.UpdateData_BengkelOnly("UPDATE tempstall SET noStall = '" & stl & "', jamMulai = '" & jmMul & "', jamSelesai = '" & jmSel & "', rate = '" & Replace(CDbl(rte), ",", ".") & "', KETERANGAN = '" & Ket & "',ADJUST = '" & Trim(adjust) & "' WHERE tanggal = '" & Format(Tgl, "mm/dd/yyyy") & "' AND keterangan LIKE '" & Left(Ket, InStr(Ket, "|") - 2) & " |%'  ")
9             End If
10        Else
11            If Left(Trim(rsTempSaveStall("KETERANGAN")), InStr(rsTempSaveStall("KETERANGAN"), "|")) = Left(Ket, InStr(Ket, "|")) Then
12                Call objHT.UpdateData_BengkelOnly("UPDATE tempstall SET noStall = '" & stl & "', jamMulai = '" & jmMul & "', jamSelesai = '" & jmSel & "', mech = '" & Trim(Text(8)) & "', rate = '" & Replace(CDbl(rte), ",", ".") & "', keterangan = '" & Ket & "',ADJUST = '" & Trim(adjust) & "' WHERE tanggal = '" & Format(Tgl, "mm/dd/yyyy") & "' AND keterangan = '" & rsTempSaveStall("KETERANGAN") & "'  ")
13            Else
14                MsgBox "Alokasi Stall dan Waktu sudah dipakai" & vbCr & "Kendaraan dengan No. Polisi : " & Trim(rsTempSaveStall!keterangan)
15                Exit Sub
16            End If
17        End If
18        If gStall = "order" Then
19            Call objHT.UpdateData_BengkelOnly("UPDATE tempStall SET flag = 'N' WHERE tanggal = '" & Format(Tgl, "mm/dd/yyyy") & "' AND keterangan = '" & Ket & "'")
20        End If
21       'On Error GoTo 0
22       Exit Sub

saveStall_Error:

23        MsgBox "Terjadi Kesalahan " & vbCrLf & ErrMessage(Erl, err.Number, " (" & err.Description & ") in procedure saveStall of Form frmOrder")
End Sub
