    Dim xBatasKr As Double
    Dim xCurrent As Double
    xBatasKr = objO.Fetch_BatasKredit_Ar(Trim(Replace(Text(1).Text, ">", "")))
    txtRp(1) = xBatasKr
    xCurrent = objO.Fetch_Current_Ar(Trim(Replace(Text(1).Text, ">", "")))
    txtRp(0) = xCurrent
