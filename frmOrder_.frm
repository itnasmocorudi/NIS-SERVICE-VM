Private Function isCurrentAR() As Boolean
1        On Error GoTo isCurrentAR_Error

2         isCurrentAR = False
3         If Trim(Text(1).Text) = "" Then Exit Function
          Dim aBatasKr As Double
          Dim aCurrent As Double
4         aBatasKr = objO.Fetch_BatasKredit_Ar(Trim(Replace(Text(1).Text, ">", "")))
5         isCurrentAR = False
6         txtRp(201) = aBatasKr
7         txtRp(1) = aBatasKr
8         aCurrent = objO.Fetch_Current_Ar(Trim(Text(1).Text))
9         txtRp(200) = aCurrent
10        txtRp(0) = aCurrent
11        If aCurrent <> 0 And aBatasKr <> 0 Then
12            nPersenAR = Round((aCurrent / aBatasKr) * 100, 0)
13        Else
14            nPersenAR = 0
15        End If
16        nAR.Caption = nPersenAR & "%"
17        nAR2.Caption = nPersenAR & "%"
          
18        If aBatasKr = 0 Then GoTo TanpaBatasAR
