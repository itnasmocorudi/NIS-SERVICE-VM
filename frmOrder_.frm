Private Sub cmdPilihDSS_Click()
1        On Error GoTo cmdPilihDSS_Click_Error

2         If gridDSS.Columns(1).value <> "Stall Manual" Then
3             If MsgBox("Apakah yakin memilih " & gridDSS.Columns(1).value & " ?", vbYesNo) = vbYes Then
4                 erTranAll = False
5                 onTR = True
6                 Call objHT.OpenTransactionBengkel
7                 On Error GoTo errorTrans
                  Dim PilihMekanik As String
                  Dim waktuMulai As String
8                 PilihMekanik = UCase(gridDSS.Columns(3).value)
              
9                 If Len(PilihMekanik) > 3 Then
                      'jika mekanik lebih dari 1
10                    PilihMekanik = Left(PilihMekanik, InStr(PilihMekanik, " ,"))
11                Else
12                    PilihMekanik = PilihMekanik
13                End If
                      
                  'mencari jam selesai (jammulai + adjust)
                  Dim jamSelesai As String
                  Dim total As Double
                  
14                Text(50) = PilihMekanik
                  
15                total = cariJumlahMenit(gridDSS.Columns(4).value) + cariJumlahMenit(Trim(Text(122)))
                  
16                jamSelesai = Format(Val(total / 60), "0#") & ":" & Format((total Mod 60), "0#")
17                waktuMulai = gridDSS.Columns(4).value
18                If Log.newJpcb = 1 Then
19                    Set rsTemp = objO.FetchData("SELECT WAKTUMULAI,WAKTUSELESAI,WAKTUMULAIISTIRAHAT,WAKTUSELESAIISTIRAHAT FROM T_STALL WITH(NOLOCK) WHERE hari = '" & IIf(Weekday(Trim(Text(65))) = 1, 6, Weekday(Trim(Text(65))) - 2) & WeekdayName(IIf(Weekday(Trim(Text(65))) = 1, 8, Weekday(Trim(Text(65)))) - 1) & "'")
20                    If rsTemp.EOF = False Then
21                        rsTemp.MoveFirst
22                        If cariJumlahMenit(waktuMulai) <= cariJumlahMenit(rsTemp!waktuMulaiIstirahat) Then
                              'If cariJumlahMenit(rsTemp!waktuSelesaiIstirahat) > cariJumlahMenit(jamSelesai) Or cariJumlahMenit(jamSelesai) > cariJumlahMenit(rsTemp!waktuSelesaiIstirahat) Then
                            'If (cariJumlahMenit(rsTemp!waktuSelesaiIstirahat) >= cariJumlahMenit(jamSelesai) And cariJumlahMenit(Trim(rsTemp!waktuMulaiIstirahat)) >= cariJumlahMenit(waktuMulai)) Or cariJumlahMenit(jamSelesai) >= cariJumlahMenit(rsTemp!waktuSelesaiIstirahat) Then
23                              If (cariJumlahMenit(Trim(rsTemp!waktuMulaiIstirahat)) <= cariJumlahMenit(jamSelesai)) Or cariJumlahMenit(jamSelesai) >= cariJumlahMenit(rsTemp!waktuSelesaiIstirahat) Then
24                                total = cariJumlahMenit(gridDSS.Columns(4).value) + cariJumlahMenit(Trim(Text(122))) + (cariJumlahMenit(rsTemp!waktuSelesaiIstirahat) - cariJumlahMenit(rsTemp!waktuMulaiIstirahat))
25                            End If
26                        End If
                           
27                    End If
28                    jamSelesai = Format(Val(total / 60), "0#") & ":" & Format((total Mod 60), "0#")
29                End If
30                Call saveStall(gridDSS.Columns(1).value, Format(Trim(Text(65)), "dd/mm/yyyy"), Trim(gridDSS.Columns(4).value), Trim(jamSelesai), Trim(txtNRate.Text), "", Trim(Text(50)), Replace(Replace(Text(14), ">", ""), " ", "") & " |" & Trim(Text(64)) & "| " & Trim(Text(3)), Trim(Text(122)))
      '            jamAwal = Trim(Text(3))
                  
31                If erTranAll = False Then
32                    Call objHT.CloseTransactionBengkel
33                    onTR = False
34                    sgnStall.Visible = True
35                    sgnStall.Caption = Trim(gridDSS.Columns(1).value)
36                Else
37                    Call objHT.CloseTransactionBengkel_err
38                    onTR = False
39                    MsgBox "Stall tidak berhasil dipilih !", vbInformation + vbOKOnly
                  '    Exit Sub
40                End If
41                frameHasilDSS.Visible = False
42                backgroundDSS.Visible = False
43                Call hitungEstimasiPenyerahan
                  
44                Exit Sub
                  
errorTrans:
45                Call objHT.CloseTransactionBengkel_err
46                onTR = False
47                MsgBox "Stall tidak berhasil dipilih !", vbInformation + vbOKOnly

48            End If
49        Else
50            backgroundDSS.Visible = False
51            backgroundDSS.Top = 10000
52            frameHasilDSS.Visible = False
              'memilih manual
              'lakukan proses manual
53            Call prosesPilihStallManual(False)
54            Exit Sub
55        End If

56       'On Error GoTo 0
57       Exit Sub

