Private Function HargaPart(rsS As ADODB.Recordset) As Double
      Dim hrg As Double
          
1        On Error GoTo HargaPart_Error

2         With rsS
3             hrg = 0
4             If rsS.State <> adStateClosed Then
5                 If Not rsS.EOF Then
6                         Set rsTemp = objO.FetchDataACC("SELECT HARGAJUALA FROM INMST WITH (NOLOCK) WHERE KODEITEM = '" & rsS("KODEITEM") & "'")
7                         If Not rsTemp.EOF Then
8                             hrg = CDbl(rsTemp("HARGAJUALA"))
9                         End If
10                    HargaPart = CDbl(hrg) * CDbl(rsS("QTY"))
11                End If
12            End If
13        End With

14       'On Error GoTo 0
15       Exit Function

HargaPart_Error:

16        MsgBox "Terjadi Kesalahan " & vbCrLf & ErrMessage(Erl, err.Number, " (" & err.Description & ") in procedure HargaPart of Form frmOrder")
End Function

