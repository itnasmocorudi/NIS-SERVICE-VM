39                Exit Sub
40            ElseIf CInt(Text(124)) <= Log.discJasa And CInt(Text(125)) <= Log.discPart Then
41                MsgBox "Disc masih didalam range disc SA.", vbInformation
42                Exit Sub
43            End If
              
44            Set rsTemp = objO.FetchData("SELECT No_Wo, No_Chassis, DiscJasaReq, DiscPartReq, infoSA FROM RequestDisc WITH (NOLOCK) WHERE no_wo = '" & Trim(Text(64)) & "' and no_chassis = '" & Trim(Text(15)) & "' and tglReq = '" & Format(Trim(Text(65)), "mm/dd/yyyy") & "' ")
45            If Not rsTemp.EOF Then
46                sSQL = "UPDATE REQUESTDISC SET DiscJasaReq = " & CInt(Trim(Text(124))) & ", DiscPartReq = " & CInt(Trim(Text(125))) & ", infoSA = '" & Trim(Replace(Text(126), ">", "")) & Trim(Replace(Text(127), ">", "")) & "',USERREQ = '" & gSA & "' WHERE no_wo = '" & Trim(Text(64)) & "' and no_chassis = '" & Trim(Text(15)) & "'"
47            Else
