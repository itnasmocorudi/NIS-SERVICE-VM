Private Sub cmdDiscKacab_Click(Index As Integer)
    If Index = 0 Then
        ''REQUEST DISC
        If DateDiff("d", Format(Log.startDiscKacab, "dd/mm/yyyy"), Format(Trim(Text(65)), "dd/mm/yyyy")) >= 0 Then
            ''2017-06-05 Permintaan disc boleh dibarengi dengan program HO hanya yang double invoice, jika program lain tidak boleh mengajukan disc kacab.
            If opTpSvc(2).value = True Then
                MsgBox "Tipe service warranty tidak diperkenankan Request Disc Kacab", vbInformation
                Exit Sub
            ElseIf opTpSvc(1).value = True Then
                If objBilling.isDuoInvoice(Trim(Text(21))) = False Then
                    MsgBox "Tipe program duo Invoice yang diperkenankan Request Disc Kacab", vbInformation
                    Exit Sub
                End If
            End If
            frameDiscKacab.Visible = True
            frameDiscKacab.Top = 6150
            
            Text(124) = 0
            Text(125) = 0
            Set rsTemp = objO.FetchData("SELECT No_Wo, No_Chassis, DiscJasaReq, DiscPartReq, infoSA FROM RequestDisc WITH (NOLOCK) WHERE no_wo = '" & Trim(Text(64)) & "' and no_chassis = '" & Trim(Text(15)) & "' and tglReq = '" & Format(Trim(Text(65)), "mm/dd/yyyy") & "' ")
            If Not rsTemp.EOF Then
                Text(124) = CDbl(rsTemp!DiscJasaReq)
                Text(125) = CDbl(rsTemp!DiscPartReq)
                Text(126) = Mid(Trim(rsTemp!infoSA), 1, 50)
                Text(127) = Mid(Trim(rsTemp!infoSA), 51, 50)
            End If
            
        Else
            MsgBox "Tanggal WO sebelum tanggal start disc kacab.", vbInformation
            Exit Sub
        End If
    ElseIf Index = 1 Then
        If CInt(Text(124)) > Log.discMaxJasa Then
            MsgBox "Disc Jasa tidak boleh melebihi " & Log.discMaxJasa & " %", vbInformation
            Exit Sub
        ElseIf CInt(Text(125)) > Log.discPartMax Then
            MsgBox "Disc Part tidak boleh melebihi " & Log.discPartMax & " %", vbInformation
            Exit Sub
        ElseIf Trim(Replace(Text(126), ">", "")) & Trim(Replace(Text(127), ">", "")) = "" Then
            MsgBox "Note SA harus diisi", vbInformation
            Exit Sub
        ElseIf Len(Trim(Replace(Text(126), ">", "")) & Trim(Replace(Text(127), ">", ""))) < 5 Then
            MsgBox "Note SA minimal 5 karakter.", vbInformation
            Exit Sub
        ElseIf CInt(Text(124)) <= Log.discJasa And CInt(Text(125)) <= Log.discPart Then
            MsgBox "Disc masih didalam range disc SA.", vbInformation
            Exit Sub
        End If
        
        Set rsTemp = objO.FetchData("SELECT No_Wo, No_Chassis, DiscJasaReq, DiscPartReq, infoSA FROM RequestDisc WITH (NOLOCK) WHERE no_wo = '" & Trim(Text(64)) & "' and no_chassis = '" & Trim(Text(15)) & "' and tglReq = '" & Format(Trim(Text(65)), "mm/dd/yyyy") & "' ")
        If Not rsTemp.EOF Then
            sSQL = "UPDATE REQUESTDISC SET DiscJasaReq = " & CInt(Trim(Text(124))) & ", DiscPartReq = " & CInt(Trim(Text(125))) & ", infoSA = '" & Trim(Replace(Text(126), ">", "")) & Trim(Replace(Text(127), ">", "")) & "',USERREQ = '" & gSA & "' WHERE no_wo = '" & Trim(Text(64)) & "' and no_chassis = '" & Trim(Text(15)) & "'"
        Else
            sSQL = "INSERT INTO RequestDisc (No_Wo, No_Chassis, DiscJasaReq, DiscPartReq, infoSA,USERREQ, tglReq) VALUES ('" & Trim(Text(64)) & "','" & Trim(Text(15)) & "'," & CInt(Trim(Text(124))) & "," & CInt(Trim(Text(125))) & ",'" & Trim(Replace(Text(126), ">", "")) & Trim(Replace(Text(127), ">", "")) & "','" & gSA & "','" & Format(Trim(Text(65)), "mm/dd/yyyy") & "') "
        End If
    
        Call objO.InsertData(sSQL)
        MsgBox "Data request disc berhasil disimpan", vbInformation
        frameDiscKacab.Visible = False
        frameDiscKacab.Top = 16150
        
    ElseIf Index = 2 Then
        frameDiscKacab.Visible = False
        frameDiscKacab.Top = 16150
    ElseIf Index = 3 Then
        Frame17.Visible = True
    End If
End Sub

