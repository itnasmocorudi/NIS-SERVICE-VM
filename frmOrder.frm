        Exit Sub
    End If
        Dim strSql As String
        strSql = "select d.package_ID,d.part_number,d.part_name,d.part_installation_est_price,d.part_quantity"
        strSql = strSql & " from BOOK a"
        strSql = strSql & " inner join BookingOnline b on b.NoFak=a.NOFAK"
        strSql = strSql & " inner join ReplBengkel99..p2_bookingonline_didx c on c.nobookingapps=b.nobookingapps"
        strSql = strSql & " inner join ReplBengkel99..p2_bookingonline_part d on d.booking_ID=c.booking_ID"
        strSql = strSql & " where d.part_type<>'PACKAGE' and a.NOFAK='" & IIf(NulSID(Text(78)) <> "", NulSID(Text(78)), "Kosong") & "'"
        strSql = strSql & " Union"
        strSql = strSql & " select e.package_ID,e.part_number,e.part_name,d.part_installation_est_price,d.part_quantity"
        strSql = strSql & " from BOOK a"
        strSql = strSql & " inner join BookingOnline b on b.NoFak=a.NOFAK"
        strSql = strSql & " inner join ReplBengkel99..p2_bookingonline_didx c on c.nobookingapps=b.nobookingapps"
        strSql = strSql & " inner join ReplBengkel99..p2_bookingonline_part d on d.booking_ID=c.booking_ID"
        strSql = strSql & " inner join ReplBengkel99..p2_bookingonline_part_pack e on e.package_ID=d.package_ID"
        strSql = strSql & " where d.part_type='PACKAGE' and a.NOFAK='" & IIf(NulSID(Text(78)) <> "", NulSID(Text(78)), "Kosong") & "'"
        Set rsHlp3 = objO.FetchData(strSql)

        Call doCreatePartTCO
        With rsPart1
        ' =========================================================================================
        If Not rsHlp3.EOF Then
            Do While Not rsHlp3.EOF
                .AddNew
                !package_ID = NulSID(rsHlp3("package_ID"))
                !part_number = NulSID(rsHlp3("part_number"))
                !part_name = NulSID(rsHlp3("part_name"))
                !part_installation_est_price = NulSID(rsHlp3("part_installation_est_price"))
                !part_quantity = NulSID(rsHlp3("part_quantity"))
