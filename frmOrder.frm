      End If
             
      If Trim(rsTemp!cuaca) <> "" Then
         rpt.Text96.SetText Trim(rsTemp!cuaca)
      End If
      
      
      If Trim(rsTemp!blowerspeedac) <> "" Then
         rpt.Text99.SetText Trim(rsTemp!blowerspeedac)
      End If
        
      If Trim(rsTemp!tempsetting) <> "" Then
         rpt.Text101.SetText Round(Trim(rsTemp!tempsetting), 0)
