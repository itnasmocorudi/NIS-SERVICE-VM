   rpt.Text89.SetText ""
   rpt.Text7.SetText ""
   rpt.Text94.SetText ""
   rpt.Text96.SetText ""
   rpt.Text99.SetText ""
   rpt.Text101.SetText ""
   rpt.Text9.SetText ""
   
   If Not rsTemp.EOF Then
      rsTemp.MoveFirst
