            Case "Macet Stop & Go"
               rpt.Text94.SetText Trim(rsTemp!laluLintas)
            Case "Lancar"
               rpt.Text94.SetText Trim(rsTemp!laluLintas)
            Case Else
               rpt.Text94.SetText "Lainnya : " & Trim(rsTemp!laluLintas)
