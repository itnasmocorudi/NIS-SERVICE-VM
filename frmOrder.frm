Private Sub TampilWaktu(Tggl As Date)
      Dim rsWaktu As ADODB.Recordset
      Dim nStall As String
      Dim i As Integer

1        On Error GoTo TampilWaktu_Error

2         GridWaktu.TextMatrix(0, 0) = "..."
3         GridWaktu.TextMatrix(0, 1) = "STALL"
          
          'FUNGSI MENGHASILKAN WAKTU TERSEDIA BERDASARKAN TGL TTN (HARI H)
4         If DateDiff("d", isnow, Tggl) <= 0 Then
5             Call objO.UpdateData("EXEC sp_lihatStall '" & Format(Tggl + 2, "mm/dd/yyyy") & "'")
6             GridWaktu.TextMatrix(0, 2) = "  H  "
7             GridWaktu.TextMatrix(0, 3) = "H + 1"
8             GridWaktu.TextMatrix(0, 4) = "H + 2"
9             GridWaktu.TextMatrix(0, 5) = "H + 3"
10        End If
          
          'FUNSGI UNTUK MENAMPILKAN WAKTU TERSEDIA H-2 SAMPAI H+1
11        Set rsWaktu = objO.FetchData("SELECT NOSTALL FROM STALLWKF WITH (NOLOCK) ORDER BY LEFT(NOSTALL,1),CASE LEFT(NOSTALL,1) WHEN 'S' THEN CAST(SUBSTRING(NOSTALL, 7, LEN(NOSTALL)-6) AS INTEGER) ELSE CAST(SUBSTRING(NOSTALL, 5, LEN(NOSTALL)-4) AS INTEGER) END, [H-2], [H-1], H, [H+1]")
12        If Not rsWaktu.EOF Then
13            i = 1
14            GridWaktu.Rows = rsWaktu.RecordCount + 1
              
15            GridWaktu.ColWidth(0) = 200
16            GridWaktu.ColWidth(1) = 700
17            GridWaktu.ColWidth(2) = 1200
18            GridWaktu.ColWidth(3) = 1200
19            GridWaktu.ColWidth(4) = 1200
20            GridWaktu.ColWidth(5) = 1200
21            nStall = ""
              
22            Do While Not rsWaktu.EOF
23                If Trim(rsWaktu("NOSTALL")) = nStall Then
24                    GridWaktu.TextMatrix(i, 1) = ""
25                    GridWaktu.TextMatrix(i, 2) = Nul(Trim(rsWaktu("H-2")), "")
26                    GridWaktu.TextMatrix(i, 3) = Nul(Trim(rsWaktu("H-1")), "")
27                    GridWaktu.TextMatrix(i, 4) = Nul(Trim(rsWaktu("H")), "")
28                    GridWaktu.TextMatrix(i, 5) = Nul(Trim(rsWaktu("H+1")))
29                Else
30                    GridWaktu.TextMatrix(i, 0) = "*"
31                    GridWaktu.TextMatrix(i, 1) = Trim(rsWaktu("NOSTALL"))
32                    GridWaktu.TextMatrix(i, 2) = Nul(Trim(rsWaktu("H-2")), "")
33                    GridWaktu.TextMatrix(i, 3) = Nul(Trim(rsWaktu("H-1")), "")
34                    GridWaktu.TextMatrix(i, 4) = Nul(Trim(rsWaktu("H")), "")
35                    GridWaktu.TextMatrix(i, 5) = Nul(Trim(rsWaktu("H+1")))
36                    nStall = Trim(rsWaktu("NOSTALL"))
37                End If
38                i = i + 1
39                rsWaktu.MoveNext
40            Loop
41        End If

42       'On Error GoTo 0
43       Exit Sub

