                                Set rsHlp = objO.FetchData("SELECT LIMITAR, HUTANG - BAYAR AS SISA, [TOP] FROM [" & dbReplikasiHO & "]..MOUHDR WITH (NOLOCK) WHERE NO_MOU = '" & Trim(Text(90)) & "'")
