   rpt.txtKodeModel.SetText ""
   rpt.txtNoRangka.SetText ""
   rpt.Text8.SetText ""
   rpt.txtNoWO.SetText ""
   ''data keluhan
   rpt.txtKeluhanPelanggan.SetText ""
   
   ''data diagnosa
   rpt.Text23.SetText ""
   rpt.Text25.SetText ""
   rpt.Text27.SetText ""
   rpt.Text29.SetText "... Hari yang lalu"
   
   rpt.Text30.SetText ""
   rpt.Text31.SetText ""
   rpt.Text32.SetText ""
   
   rpt.Text36.SetText ""
   rpt.Text37.SetText ""
   rpt.Text38.SetText ""
   
