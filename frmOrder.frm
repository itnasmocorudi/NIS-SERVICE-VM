   rpt.Text61.SetText ""
   rpt.Text62.SetText ""
   rpt.Text63.SetText ""
   rpt.Text64.SetText ""
   rpt.Text65.SetText ""
   rpt.Text66.SetText ""
   rpt.Text67.SetText ""
   
