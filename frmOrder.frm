Private Sub cmdTambahWAC_Click()

   On Error GoTo cmdTambahWAC_Click_Error
    
    If Trim(Text(108)) = "" Or Trim(Text(128)) = "" Then
        MsgBox "Silahkan pilih antrian terlebih dahulu", vbInformation
        Exit Sub
    End If
    If cbWACBagian.value = "" Or UCase(cbWACBagian.value) = "- PILIH BAGIAN -" Then
        MsgBox "Bagian harus dipilih ", vbInformation
        Exit Sub
    Else
        If cbWACKondisi.value = "" Then
            MsgBox "Kondisi harus dipilih ", vbInformation
            Exit Sub
        Else
            If UCase(cbWACPosisi.value) = "- PILIH POSISI -" Then
                cbWACPosisi.value = ""
            End If
            Set rsTemp = objO.FetchData("SELECT matrik FROM masterPosisi WITH (NOLOCK) WHERE bagian = '" & Trim(cbWACBagian.value) & "' AND posisi = '" & Trim(cbWACPosisi.value) & "'")
            Dim matrix As String
            Dim idAntrian As Double
            matrix = ""
            If Not rsTemp.EOF Then
                matrix = Nul(rsTemp!matrik)
            End If
            If Trim(matrix) = "" Then
                MsgBox "Matrix tidak ditemukan, proses dibatalkan", vbInformation
                Exit Sub
            End If
            Set rsTemp = objO.FetchData("select top 1 ID from " & Log.LogQueue & "..Queue where Nomor = '" & Trim(Text(108)) & "' and Tipe = '" & Trim(Text(128)) & "' and CONVERT(varchar(10), Tgl_Panggil, 101) = '" & Format(TglYYYYMMDD(Text(65)), "MM/DD/YYYY") & "'")
            If Not rsTemp.EOF Then
                idAntrian = Nul(rsTemp!id, 0)
            End If
            sSQL = "INSERT INTO DETAILWAC (IDANTRIAN,MATRIX,KONDISI,BAGIAN,POSISI,ADAFOTO) VALUES (" & idAntrian & ",'" & matrix & "','" & Nul(cbWACKondisi.value) & "','" & Nul(cbWACBagian.value) & "','" & Nul(cbWACPosisi.value) & "','0')"
            Call objO.InsertData(sSQL)
            bolehPasangTanda = True
            koorWAC = ""
            MsgBox "Data berhasil disimpan", vbInformation
            refreshDataWAC
            Adodc2(0).ConnectionString = SQLCONBengkel
            Adodc2(0).RecordSource = "SELECT distinct BAGIAN from MasterPosisiBP a inner join MasterTipeWAC b on a.TipeWAC = b.TipeWAC where b.Mdl = '" & Left(Trim(Text(10)), InStr(Trim(Text(10)), "-") - 1) & "'" '"select DISTINCT BAGIAN FROM masterPosisi WITH (NOLOCK)"
            Adodc2(0).Refresh
            cbWACBagian.DataSourceList = Adodc2(0)
            cbWACBagian.DataFieldList = "BAGIAN"
            cbWACBagian.Columns(0).Width = 3000
            cbWACBagian.Text = "- Pilih Bagian -"
            cbWACKondisi.DataSourceList = Nothing
            cbWACKondisi.Refresh
            cbWACKondisi.Text = "- Pilih Kondisi -"
            cbWACPosisi.DataSourceList = Nothing
            cbWACPosisi.Refresh
            cbWACPosisi.Text = "- Pilih Posisi -"
        End If
    End If

   On Error GoTo 0
   Exit Sub

