      ''data keluhan
      rpt.txtKeluhanPelanggan.SetText Trim(rsTemp!keluhan)
      
      ''data diagnosa
      
      ''gejala pertama kali
      If Trim(rsTemp!gejalapertama) <> "" Then
         Select Case UCase(Trim(rsTemp!gejalapertama))
            Case "HARI INI"
               rpt.Text23.SetText " X"
            Case "MINGGU LALU"
               rpt.Text25.SetText " X"
            Case Else
               rpt.Text27.SetText " X"
               rpt.Text29.SetText Mid(Trim(rsTemp!gejalapertama), 1, Len(rsTemp!gejalapertama) - 15) & " Hari yang lalu"
         End Select
      End If
      
      If Trim(rsTemp!frekuensi) <> "" Then
         Select Case Trim(rsTemp!frekuensi)
             Case "Sekali"
               rpt.Text30.SetText " X"
            Case "Kadang"
               rpt.Text31.SetText " X"
            Case Else
               rpt.Text32.SetText " X"
         End Select
      End If
      
      If Trim(rsTemp!indikator) <> "" Then
