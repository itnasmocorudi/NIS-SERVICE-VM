Private Sub cbFir_Change(Index As Integer)
    If Index = 0 Then
        If cbFir(Index).Text <> "" Then
            sSQL = "select distinct CASE WHEN LTRIM(RTRIM(subkategori1)) = '' THEN '-' when isnull(subkategori1,'') = '' then '-' ELSE LTRIM(RTRIM(subkategori1)) END komponen from masterproblem with (nolock) where kategori = '" & NulSID(cbFir(0).Text) & "'"
            Set rsTemp = objO.FetchData(sSQL)
            If Not rsTemp.EOF Then
                rsTemp.MoveFirst
                cbFir(1).Clear
                Do While Not rsTemp.EOF
                    cbFir(1).AddItem NulSID(rsTemp!komponen)
                    rsTemp.MoveNext
                Loop
                rsTemp.MoveFirst
                cbFir(1).Text = NulSID(rsTemp!komponen)
            End If
        End If
    ElseIf Index = 1 Then
        If cbFir(Index).Text <> "" Then
            sSQL = "select distinct CASE WHEN LTRIM(RTRIM(subkategori2)) = '' THEN '-' when isnull(subkategori2,'') = '' then '-' ELSE LTRIM(RTRIM(subkategori2)) END komponen from masterproblem with (nolock) where kategori = '" & NulSID(cbFir(0).Text) & "' and (CASE WHEN LTRIM(RTRIM(subkategori1)) = '' THEN '-' when isnull(subkategori1,'') = '' then '-' ELSE LTRIM(RTRIM(subkategori1)) END = '" & NulSID(cbFir(1).Text) & "')"
            Set rsTemp = objO.FetchData(sSQL)
            If Not rsTemp.EOF Then
                rsTemp.MoveFirst
                cbFir(2).Clear
                Do While Not rsTemp.EOF
                    cbFir(2).AddItem NulSID(rsTemp!komponen)
                    rsTemp.MoveNext
                Loop
                rsTemp.MoveFirst
                cbFir(2).Text = NulSID(rsTemp!komponen)
            End If
        End If
    ElseIf Index = 2 Then
        If cbFir(Index).Text <> "" Then
            sSQL = "select distinct idproblem, suggestion as komponen from masterproblem with (nolock) where kategori = '" & NulSID(cbFir(0).Text) & "' and (CASE WHEN LTRIM(RTRIM(subkategori1)) = '' THEN '-' when isnull(subkategori1,'') = '' then '-' ELSE LTRIM(RTRIM(subkategori1)) END = '" & NulSID(cbFir(1).Text) & "') and (CASE WHEN LTRIM(RTRIM(subkategori2)) = '' THEN '-' when isnull(subkategori2,'') = '' then '-' ELSE LTRIM(RTRIM(subkategori2)) END = '" & NulSID(cbFir(2).Text) & "')"
            Set rsTemp = objO.FetchData(sSQL)
            If Not rsTemp.EOF Then
                rsTemp.MoveFirst
                Text(135) = NulSID(rsTemp!komponen)
                idProblem = NulSID(rsTemp!idProblem)
                sSQL = "select action  from ToDoList with (nolock) where idproblem = '" & NulSID(rsTemp!idProblem) & "'"
                Set rsTemp = objO.FetchData(sSQL)
                Text(130) = ""
                Text(131) = ""
                Text(132) = ""
                If Not rsTemp.EOF Then
                    rsTemp.MoveFirst
                    Text(130) = Left(NulSID(rsTemp!Action), 60)
                    rsTemp.MoveNext
                    If Not rsTemp.EOF Then
                        Text(131) = Left(NulSID(rsTemp!Action), 60)
                        rsTemp.MoveNext
                        If Not rsTemp.EOF Then
                            Text(132) = Left(NulSID(rsTemp!Action), 60)
                            rsTemp.MoveNext
                        End If
                    End If
                End If
            End If
        End If
    Else
    
    End If
End Sub

Private Sub cbFir_Click(Index As Integer)
    Call cbFir_Change(Index)
End Sub

