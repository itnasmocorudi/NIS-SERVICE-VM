Private Sub panggilVOJobOrderLockDisc()
    ''sSQL = "select REP,DISC,DISCRP,FREEC from vo_joborderlockdisc WITH (NOLOCK) WHERE NO_WO = '" & NulSID(text(0)) & "' AND NO_CHASSIS = '" & NulSID(text(17)) & "'"
    sSQL = "select REP,DISC,DISCRP,FREEC from vo_joborderlockdisc WITH (NOLOCK) WHERE NO_WO = '" & NulSID(Text(0)) & "' AND NO_CHASSIS = '" & NulSID(Text(17)) & "' and FS_LOG_DEL = ''"
    Dim rsJobOrderLD    As ADODB.Recordset
    Dim hargaCust       As Double
    Set rsJobOrderLD = objO.FetchData(sSQL)
    '        If Not rsJobOrderLD.EOF And Not rsJob.EOF Then
    If Not rsJobOrderLD.EOF And rsJob.State Then
        If Not rsJob.EOF Then rsJob.MoveFirst
        rsJobOrderLD.MoveFirst
        hargaCust = 0
        Do While Not rsJobOrderLD.EOF
            rsJob.Find "JOB = '" & Trim(rsJobOrderLD!rep) & "'", , adSearchForward, 1
            If Not rsJob.EOF Then
                hargaCust = 0
                '' 20191114 | REQ MB THANIA | HARGA UNTUK CUSTOMER MENGGUNAKAN HARGA NCM
                If rsJobOrderLD!FREEC = 1 Then
                    hargaCust = objBilling.takeClassPrice(rsTemp("MODEL"), 1)
                    ''rsJob!hrg = Val(CDbl(hargaCust) * k2t(rsJob!Rate))
                    If Log.multipleMarketing = 1 And DateDiff("D", Format(Log.tglmultipleMarketing, "DD/MM/YYYY"), Format(Text(43), "DD/MM/YYYY")) >= 0 Then
                        If rsJob!isFP = True Then
                            ''jika fix price tidak ada perubahan harga
                        Else
                            rsJob!hrg = Val(CDbl(hargaCust) * rsJob!Rate)
                        End If
                    Else
                        rsJob!hrg = Val(CDbl(hargaCust) * rsJob!Rate)
                    End If
                End If
                rsJob("DISC") = rsJobOrderLD!disc
                rsJob("DISCRP") = rsJobOrderLD!DISCRP
                ''20200224 || harga sub = harga - disc rupiah karena disc % diround 2 sehingga selisih beberapa rupiah
                ''-----------------------------------------------------------------------------------------------------
                rsJob("STLDISC") = Round((rsJob!hrg) - rsJob!DISCRP, 0) 'Round(((100 - CDbl(rsJob!disc)) / 100) * CDbl(rsJob!hrg))
                If rsJobOrderLD!FREEC = 1 Then
                    rsJob!FREEC = True
                    subJob = subJob - CDbl(rsJob("HRG")) ''subJob = subJob - (CDbl(rsJob("HRG")) * (CDbl(rsJob("DISC")) / 100))
                Else
                    rsJob!FREEC = False
                End If
            End If
            rsJobOrderLD.MoveNext
        Loop
    End If
    jobGrid.ReBind
    If rsJob.State Then
        If Not rsJob.EOF Then
            rsJob.MoveFirst
            Dim nilaiJob As Double
            nilaiJob = 0
            Do While Not rsJob.EOF
                If nDuoInv Then
                    If rsJob!FREEC = True Then
                        nilaiJob = nilaiJob + CDbl(rsJob("STLDISC"))
                    Else
                        ''20190910 || request mb thania yang dihitung sesuai centangan
                        nilaiJob = nilaiJob + 0 ''nilaiJob = nilaiJob + CDbl(rsJob("STLDISC"))
                    End If
                Else
                    nilaiJob = nilaiJob + CDbl(rsJob("STLDISC"))
                End If
                rsJob.MoveNext
            Loop
            Text(22) = nilaiJob
            Text(29) = Round(CDbl(Text(22)) + CDbl(Text(24)) + CDbl(Text(25)) + CDbl(Text(27)), 0) '+ CDbl(text(28))
        End If
    End If
End Sub

