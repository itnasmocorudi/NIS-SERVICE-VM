Private Function cariTotalManual() As Double

    On Error GoTo vbError
    cariTotalManual = 0
    If rsJob.State <> adStateClosed Then
        rsJob.MoveFirst
        Do While Not rsJob.EOF
            ''cariTotalManual = cariTotalManual + IIf(rsJob("FreeC"), 0, (rsJob("HRG") - IIf(rsJob("DISC") <> 100, (rsJob("HRG") - rsJob("DISCRP")), 0)))
            If Log.discKacab = 1 Then
                cariTotalManual = cariTotalManual + IIf(rsJob("FreeC"), 0, (rsJob("HRG") - IIf(rsJob("DISC") <> 100, (rsJob("DISCRP")), 0)))
            Else
                cariTotalManual = cariTotalManual + IIf(rsJob("FreeC"), 0, (rsJob("HRG") - IIf(rsJob("DISC") <> 100, (rsJob("HRG") - rsJob("DISCRP")), 0)))
            End If
            
            rsJob.MoveNext
        Loop
    End If
    Exit Function
    
vbError:
    cariTotalManual = 0
End Function


