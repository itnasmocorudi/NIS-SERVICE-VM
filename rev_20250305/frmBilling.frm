Private Sub CexRangeFP()

    Dim objIn As New BClsBilling
    Dim rsMaterai As ADODB.Recordset
   On Error GoTo CexRangeFP_Error
    isMat_OK = True
    isFP_OK = True
    If objIn.FetchAvailable_FPNew = False Then
        isFP_OK = False
    End If
    isNoFP_OK = True
    isNoFP_New = objIn.FetchRange_FPNew
    If objIn.FetchMinRange_FPNew >= isNoFP_New Then
        isNoFP_OK = False
    End If
    
    keteranganMat1 = ""
    keteranganMat2 = ""
    
    '' 20180611DEV02'TAMBAHMATERAI
    If Log.fakturMaterai = 1 Then
        sSQL = "select saldo-terpakai as saldo,saldo-terpakai-isnull((select top 1 remindsisamaterai from [FAKTUR" & Right(gDb, 2) & "]..Dealer),0) as tersisa,NoIjin from [FAKTUR" & Right(gDb, 2) & "]..FPKonterMat where Tahun = year(getdate()) and aktiv = 'Y' order by TglEntry desc"
        Set rsMaterai = objO.FetchData(sSQL)
        If Not rsMaterai.EOF Then
            
            
            totalInv1 = RepRp(SpyRound(CDbl((subPartGenuine * (1 - (CDbl(Text(23)) / 100))) + (subPartNGenuine * (1 - (CDbl(Text(23)) / 100))) + CDbl(Text(28)) + (subOliGenuine * (1 - (CDbl(Text(23)) / 100))) + (subOliNGenuine * (1 - (CDbl(Text(23)) / 100))) + CDbl(IIf(nDuoInv, 0, CDbl(text42.Text))) + CDbl(Text(27)) + IIf(lblPDS.Visible, subJob, CDbl(Text(22))) + CDbl(Text(39))), 0))
            totalInv2 = IIf(lblPDS.Visible, Val(subJob), IIf(nDuoInv, Val(subJob), Val(CDbl(Text(22)))))
            
            If Log.materai2021 = 1 Then
                If totalInv1 > 250000 Then
                    If totalInv1 >= 5000000 Then
                        keteranganMat1 = "BEA MATERAI LUNAS 10000"
                        totalInv1 = 10000
                    End If
                Else
                    totalInv1 = 0
                End If
                
                If totalInv2 > 5000000 Then
                    keteranganMat2 = "BEA MATERAI LUNAS 10000"
                    totalInv2 = 10000
                Else
                    totalInv2 = 0
                End If
            Else
                If totalInv1 > 250000 Then
                    If totalInv1 >= 2000000 Then
                        keteranganMat1 = "BEA MATERAI LUNAS 6000"
                        totalInv1 = 6000
                    Else
                        keteranganMat1 = "BEA MATERAI LUNAS 3000"
                        totalInv1 = 3000
                    End If
                Else
                    totalInv1 = 0
                End If
                
                If totalInv2 > 250000 Then
                    If totalInv2 >= 2000000 Then
                        keteranganMat2 = "BEA MATERAI LUNAS 6000"
                        totalInv2 = 6000
                    Else
                        keteranganMat2 = "BEA MATERAI LUNAS 3000"
                        totalInv2 = 3000
                    End If
                Else
                    totalInv2 = 0
                End If
            End If
            If (totalInv1 + totalInv2) > rsMaterai!saldo Then
                
                isMat_OK = False
                MsgBox "No Ijin materai : " & NulSID(rsMaterai!NOIJIN) & " Tidak cukup untuk membuat invoice ini." & Chr(13) & "Segera Hubungi Administrasi (ADH) - FP", vbInformation + vbOKOnly

            ElseIf rsMaterai!tersisa < 0 Then
            
                'isMat_OK = False
                MsgBox "No Ijin Materai : " & NulSID(rsMaterai!NOIJIN) & vbCrLf & "Sisa Saldo Tinggal " & Format(rsMaterai!saldo, "#0,#") & Chr(13) & "Segera Hubungi Administrasi (ADH) - FP", vbInformation + vbOKOnly
                noMat_OK = NulSID(rsMaterai!NOIJIN)
                'MsgBox "No Ijin materai : " & NulSID(rsMaterai!NOIJIN) & " Tidak cukup untuk membuat invoice ini." & Chr(13) & "Segera Hubungi Administrasi (ADH) - FP", vbInformation + vbOKOnly
            Else
                noMat_OK = NulSID(rsMaterai!NOIJIN)
            End If
        Else
            isMat_OK = False
            MsgBox "Tidak dapat mengambil No Ijin Materai.", vbInformation
        End If
    End If

   'On Error GoTo 0
   Exit Sub

CexRangeFP_Error:
'' 20181002REV2 ' MENCATAT ERROR LINE NUMBER SEBELUM DITAMPILKAN
varErlError = Erl
varErrNumber = err.Number
'' varErlError,varErrNumber
    MsgBox "Terjadi Kesalahan " & vbCrLf & ErrMessage(varErlError, varErrNumber, " (" & err.Description & ") in procedure CexRangeFP of Form frmBilling")
End Sub
