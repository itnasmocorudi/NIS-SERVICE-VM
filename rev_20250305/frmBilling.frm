Private Function cekSimpanFOP() As Boolean
    Dim hasil As Boolean
    hasil = True
    If gKdPlgTAM = "" Or gNmTAM = "" Or gNpwpTAM = "" Then
        MsgBox "Kodelgn TAM belum disetting di profil", vbInformation
        Call hapusForm
        Unload Me
        hasil = False
    End If
    ''cek part / oli
    '' ---------------------------------
    If rsPart.RecordCount > 0 Then
        rsPart.MoveFirst
        tamOliGenuine = 0
        tamPartGenuine = 0
        Do While Not rsPart.EOF
            If rsPart!FREEC = False And rsPart!terlibat = True And rsPart!oli = True Then
                tamOliGenuine = tamOliGenuine + rsPart!Harga
            ElseIf rsPart!FREEC = False And rsPart!terlibat = True And rsPart!oli = False Then
                tamPartGenuine = tamPartGenuine + rsPart!Harga
            End If
            rsPart.MoveNext
        Loop
    End If
    
    '' 20210115REV  |
    'If tagihanFOP = "TAM" And frameFOP.Visible = False Then
        tblSimpan.Enabled = False
        Text(50) = ""
        Text(51) = ""
    '    frameFOP.Visible = True
    '    hasil = False
    'End If
    cekSimpanFOP = hasil
End Function

Private Sub cariTotalSubletFOP()
    If rsSublet.RecordCount > 0 Then
        rsSublet.MoveFirst
        Do While Not rsSublet.EOF
            If rsSublet!terlibat = True And rsSublet!FREEC = False Then
                subSubletTAM = subSubletTAM + (rsSublet!qty * rsSublet!Price)
            End If
            rsSublet.MoveNext
        Loop
        rsSublet.MoveFirst
    End If
End Sub

Private Sub cekDataTelp()
    Set rsTemp = objO.FetchData("SELECT ANCUST,TELPANCUST FROM JOBDTA WHERE NO_WO = '" & Trim(Text(0)) & "'")
    If rsTemp.RecordCount > 0 Then
        rsTemp.MoveFirst
        noTelepon = Trim(rsTemp("telpancust"))
        namaTelepon = Trim(rsTemp("ANCUST"))

        If noTelepon <> "" Then
            If InStr(noTelepon, "/") <> 0 Then '-------------------------------------------- Jika "081/082"
                If Trim(Left(noTelepon, 2)) = "08" Or Trim(Left(noTelepon, 2)) = "02" Then '---- Jika "081"="08" Or "081"="02"
                    noTelepon = Trim(Left(noTelepon, InStr(noTelepon, "/") - 1)) '------------------ "081"
                Else '------------------------------------------------------------------
                    If Trim(Mid(noTelepon, InStr(noTelepon, "/") + 1, 2)) = "08" Or Trim(Mid(noTelepon, InStr(noTelepon, "/") + 1, 2)) = "02" Then
                        noTelepon = Trim(Mid(noTelepon, InStr(noTelepon, "/") + 1)) '--------------- "082"
                    Else
                        nTuj = True
                    End If
                End If
            Else '-------------------- Jika <> "081/082"
                If InStr(noTelepon, " 0") <> 0 Then '--------------------------------------- Jika "ABC 081"
                    If Trim(Mid(noTelepon, InStr(noTelepon, " 0") + 1, 2)) = "08" Or Trim(Mid(noTelepon, InStr(noTelepon, " 0") + 1, 2)) = "02" Then
                        NoTuj = Trim(Mid(noTelepon, InStr(noTelepon, " 0") + 1)) '--------------------- "081"
                    Else
                        nTuj = True
                    End If
                Else
                    If InStr(noTelepon, ":0") <> 0 Then '----------------------------------- Jika "ABC:081"
                        If Trim(Mid(noTelepon, InStr(noTelepon, ":0") + 1, 2)) = "08" Or Trim(Mid(noTelepon, InStr(noTelepon, ":0") + 1, 2)) = "02" Then
                            noTelepon = Trim(Mid(noTelepon, InStr(noTelepon, ":0") + 1)) '----------------- "081"
                        Else
                            nTuj = True
                        End If
                    Else
                        If InStr(noTelepon, "-0") <> 0 Then '------------------------------------ Jika "ABC-081"
                            If Trim(Mid(noTelepon, InStr(noTelepon, "-0") + 1, 2)) = "08" Or Trim(Mid(noTelepon, InStr(noTelepon, "-0") + 1, 2)) = "02" Then
                                NoTuj = Trim(Mid(noTelepon, InStr(noTelepon, "-0") + 1)) '----------------- "081"
                            Else
                                nTuj = True
                            End If
                        Else
                            If InStr(noTelepon, "-") <> 0 Then
                                noTelepon = Replace(noTelepon, "-", "")
                            Else
                                If InStr(noTelepon, "+") = 1 Then '---------------------------------------- Jika "+62"
                                    If Trim(Mid(noTelepon, InStr(noTelepon, "+") + 1, 2)) = "62" Then
                                        noTelepon = Replace(noTelepon, "+62", "0") '-------------------
                                    Else
                                        nTuj = True
                                    End If
                                Else
                                    nTuj = True
                                End If
                            End If
                        End If
                    End If
                End If
            End If
        End If
    End If
End Sub


