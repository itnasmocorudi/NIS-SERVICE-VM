Private Sub simpanDIDX()
Dim NoFak, noBookingId, eventID, inspection As String
                
                inspection = objHT.FetchDataBengkel_String("SELECT SNJ1 from inspection where nowo = '" & Trim(Text(0)) & "'")
                If inspection = "" Then
                    inspection = "NO SUGGESTION"
                End If
                NoFak = objHT.FetchDataBengkel_String("SELECT nofak from jobdta where no_wo = '" & Trim(Text(0)) & "'")
                If NoFak <> "" Then
                    noBookingId = objO.FetchData_String("SELECT KODETIPE FROM book WITH (NOLOCK) WHERE nofak = '" & NoFak & "' ")
                    If NulSID(noBookingId) <> "" Then
                         '' isi nobookingapp dan kodeprogram
                        If InStr(1, NulSID(noBookingId), "#|#") > 0 Then
                            noBookingId = Left(NulSID(noBookingId), InStr(1, NulSID(noBookingId), "#|#") - 1)
                        End If
                    End If
                    If NulSID(noBookingId) = "" Then
                        noBookingId = Right(gDb, 2) & "." & aWO
                    End If
                    NoBooking = Right(gDb, 2) & "." & NoFak
                Else
                    NoBooking = Right(gDb, 2) & "." & aWO
                    noBookingId = Right(gDb, 2) & "." & aWO
                End If
                eventID = objO.FetchDataHO_String("select event_id from didx..bookingonline_didx_toSend where nobookingapps = '" & noBookingId & "'")
                objHT.InsertData_Bengkel ("UPDATE [" & dbReplikasiHO & "]..MonitorSvcProggres SET technical_complete_datetime = getdate(),invoice_submitted_datetime = GETDATE(),service_explanation_datetime = GETDATE(),next_service_suggestion = '" & inspection & "' WHERE wo_number = '" & Right(gDb, 2) & "." & Trim(Text(0)) & "'")
                
                sSQL = "INSERT INTO [" & dbReplikasiHO & "]..kirimDataDidx (tipe,nobookingapps,nobooking,noSPK,kodedealer,status,proses,event_no,tglentry) VALUES ('MONITORINGGR','" & Right(gDb, 2) & "." & Trim(Text(0)) & "','" & Right(gDb, 2) & "." & Trim(Text(0)) & "','','" & Right(gDb, 2) & "','BILLING','0','" & eventID & "',GETDATE())"
                Call objHT.InsertData_Bengkel(sSQL)
End Sub
Private Sub Saving_Log_HO(nStatus As String, isSQl As String, n2 As String)
    If Left(n2, 1) <> "i" Then
        Call objHO.AddNew_LogHO(Trim(Text(0)), nStatus, "INV" & n2, Replace(Replace(isSQl, "')", "','" & Log.LogBengkel & "')"), ") VALUES (", ",CABANG) VALUES ("))
    Else
        Call objHO.AddNew_LogHO(Trim(Text(0)), nStatus, "INV" & n2, isSQl)
    End If
End Sub

