Attribute VB_Name = "aLockAR"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit
Private objAs As New ClsDataPelanggan

Private Sub cmdExit_Click()
    Unload Me
End Sub

Private Sub Form_Load()
    Dim i As Integer
    Set Grid1.DataSource = objAs.FetchDataLockAR_DATA
    Set Grid2.DataSource = objAs.FetchDataCust_OnAR_Overdue_DATA(3)
    With Me.cboH
        .Clear
        For i = 0 To 30
            .AddItem "H-" & i
        Next i
        .Text = "H-3"
    End With
End Sub

Private Sub Zom_Click()
    On Error GoTo err:
    Set Grid2.DataSource = objAs.FetchDataCust_OnAR_Overdue_DATA(Val(Replace(cboH.Text, "H-", "")))
err:
End Sub
